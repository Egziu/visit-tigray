# Visit Tigray environment template. Copy to .env and replace EVERY placeholder.
# Never commit .env. Generate secrets with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ENVIRONMENT=development            # development | test | staging | production
SECRET_KEY=replace-with-48+-random-characters
POSTGRES_PASSWORD=replace-me
VT_APP_PASSWORD=replace-me
VT_MIGRATOR_PASSWORD=replace-me
PUBLIC_BASE_URL=http://localhost:3000
REQUIRE_STAFF_MFA=true

# --- AI (Tigray Intelligence Engine) -----------------------------------------
# fully_local | local_first_cloud_fallback | cloud_assisted | retrieval_only | deterministic | offline
AI_DEFAULT_MODE=fully_local
LOCAL_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M   # pull into Ollama: docker compose exec ollama ollama pull <model>
EMBEDDING_PROVIDER=hashing                    # hashing (offline baseline) | ollama (set EMBEDDING_MODEL, dim 384)
# Optional cloud provider — only used if an administrator permits a cloud mode (audited):
CLOUD_AI_BASE_URL=
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=

# --- Identity (Keycloak / any OIDC provider) ----------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
KEYCLOAK_ADMIN_PASSWORD=replace-me

# --- Media & scanning -----------------------------------------------------------
CLAMD_HOST=                 # e.g. clamav (required outside development)
MINIO_ROOT_PASSWORD=replace-me

# --- Notifications (aggregate reports only to messaging channels) ---------------
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.invalid
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=[]

# --- Web --------------------------------------------------------------------------
NEXT_PUBLIC_MAP_STYLE_URL=  # licensed MapLibre style URL; empty = accessible list/SVG fallback
GRAFANA_ADMIN_PASSWORD=replace-me
