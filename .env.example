# Set strong values before deployment; never commit actual secrets.
ADMIN_TOKEN=replace-with-a-long-random-secret
DATABASE_PATH=./data/tigray.sqlite3
# Travel bookings disabled until formally authorized and safety-reviewed.
ENABLE_BOOKINGS=false
# Optional AI provider: OpenAI-compatible chat completions endpoint.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# CORS: specify only trusted origins for deployed API.
ALLOWED_ORIGINS=http://localhost:8000
