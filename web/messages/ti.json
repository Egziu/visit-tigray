  "about": {
    "title": "ብዛዕባ እዚ መድረኽ",
    "statusTitle": "ኩነታት",
    "statusBody": "ትግራይ ብጽሑ 2.0 ብሰርክ ቴክኖሎጂስ ግሩፕ ንቢሮ ባህልን ቱሪዝምን ትግራይ ከም ሓሳብ ዝተሰርሐ ቅድመ-ሕታም መድረኽ እዩ። ወግዓዊ ናይ መንግስቲ ኣገልግሎት ኣይኮነን፣ ብቢሮ ድማ ገና ኣይተፈቕደን።",
    "dataTitle": "ሓበሬታ",
    "dataBody": "“ሰብ-ሰርሖ ናይ ፈተነ ሓበሬታ” ዝተባህሉ መእተዊታት ናይ ምምዕባል ቦታ-ሓለውቲ እዮም፣ ዝተረጋገጹ ሓቅታት ኣይኮኑን። ዝተሓተሙ ሓቅታት ምንጭታቶምን ዕለት ምርግጋጾምን የርእዩ።",
    "aiTitle": "ሰብ-ሰርሖ ኣእምሮ",
    "aiBody": "ኤ.ኣይ. መራሒ ኣብ ዝተዳለወሉ ብውሽጣዊ ሞዴላት ይሰርሕ፣ ካብ ዝጸደቐ ፍልጠት ጥራይ ይምልስ። ክጋገ ይኽእል፤ ብዛዕባ ድሕንነት ጉዕዞ፣ ዋጋ ወይ ፍቓድ ፈጺሙ ኣይውስንን።",
    "privacyTitle": "ብሕትውና",
