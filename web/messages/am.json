  "about": {
    "title": "ስለዚህ መድረክ",
    "statusTitle": "ሁኔታ",
    "statusBody": "ትግራይን ይጎብኙ 2.0 በሰርክ ቴክኖሎጂስ ግሩፕ ለትግራይ ባህልና ቱሪዝም ቢሮ እንደ ሐሳብ የተገነባ ቅድመ-እትም መድረክ ነው። ይፋዊ የመንግሥት አገልግሎት አይደለም፤ በቢሮውም ገና አልተፈቀደም።",
    "dataTitle": "መረጃ",
    "dataBody": "“ሰው ሰራሽ የሙከራ መረጃ” የተባሉ ግቤቶች የልማት ቦታ ያዢዎች እንጂ የተረጋገጡ እውነታዎች አይደሉም። የታተሙ እውነታዎች ምንጮቻቸውንና የተረጋገጡበትን ቀን ያሳያሉ።",
    "aiTitle": "ሰው ሰራሽ አስተውሎት",
    "aiBody": "የኤአይ መሪው በተዋቀረበት ቦታ በአካባቢያዊ ሞዴሎች ይሠራል፤ ከጸደቀ ዕውቀት ብቻ ይመልሳል። ሊሳሳት ይችላል፤ ስለ ጉዞ ደኅንነት፣ ዋጋ ወይም ፈቃድ ፈጽሞ አይወስንም።",
    "privacyTitle": "ግላዊነት",
    "privacyBody": "የሚያስፈልገውን ብቻ እንሰበስባለን፣ የአካባቢ መረጃን ከፎቶዎች እናስወግዳለን፣ መረጃዎን እንዲያወጡ ወይም እንዲሰርዙ እንፈቅዳለን።"
  },
